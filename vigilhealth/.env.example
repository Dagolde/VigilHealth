# =============================================================================
# VigilHealth Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your actual values.
# Never commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — Database, Auth, Realtime, Storage
# https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# -----------------------------------------------------------------------------
# Mapbox — Interactive Maps
# https://account.mapbox.com/access-tokens/
# Use a URL-restricted public token for NEXT_PUBLIC_MAPBOX_TOKEN
# -----------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token_here

# -----------------------------------------------------------------------------
# Resend — Transactional Email
# https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# The public URL of your deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret for NextAuth / JWT signing (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your_nextauth_secret_here

# -----------------------------------------------------------------------------
# Deployment Phase
# phase1 = Vercel + Supabase (free tier)
# phase2 = CloudPanel + self-hosted PostgreSQL
# -----------------------------------------------------------------------------
DEPLOYMENT_PHASE=phase1

# -----------------------------------------------------------------------------
# Telehealth Integration
# Webhook secret for verifying consultation completion callbacks
# -----------------------------------------------------------------------------
TELEHEALTH_WEBHOOK_SECRET=your_telehealth_webhook_secret_here

# -----------------------------------------------------------------------------
# Stripe — Payments (Premium Listings, Safe Badges, B2B Subscriptions)
# https://dashboard.stripe.com/apikeys
# For international users (USD, EUR, GBP, etc.)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# -----------------------------------------------------------------------------
# Paystack — Payments for African Markets (NGN, GHS, KES, ZAR)
# https://dashboard.paystack.com/#/settings/developer
# Nigerian businesses: use your Paystack account registered in Nigeria
# Supports: cards, bank transfer, USSD, mobile money
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
# Paystack sends webhooks to /api/billing/paystack/webhook
# Set this URL in your Paystack dashboard: https://dashboard.paystack.com/#/settings/developer

# -----------------------------------------------------------------------------
# External Health Data APIs
# -----------------------------------------------------------------------------
# WHO Disease Outbreak News API base URL
WHO_API_BASE_URL=https://www.who.int/emergencies/disease-outbreak-news/api

# CDC NNDSS Socrata API base URL
CDC_NNDSS_BASE_URL=https://data.cdc.gov/resource

# -----------------------------------------------------------------------------
# Cron Job Security
# Secret token for authenticating Vercel cron job requests
# -----------------------------------------------------------------------------
CRON_SECRET=your_cron_secret_here

# -----------------------------------------------------------------------------
# Web Push Notifications (VAPID keys)
# Generate with: npx web-push generate-vapid-keys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@vigilhealth.app

# -----------------------------------------------------------------------------
# Analytics (PostHog — privacy-friendly)
# https://posthog.com/docs/libraries/next-js
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# =============================================================================
# Phase 2 Environment Variables (CloudPanel Migration)
# Only required when DEPLOYMENT_PHASE=phase2
# =============================================================================

# -----------------------------------------------------------------------------
# Phase 2: Direct PostgreSQL Connection
# Used when migrating from Supabase to self-hosted PostgreSQL on CloudPanel
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/vigilhealth
# DB_POOL_SIZE=20

# -----------------------------------------------------------------------------
# Phase 2: Socket.io Realtime Server
# Replaces Supabase Realtime when self-hosting
# -----------------------------------------------------------------------------
# SOCKET_IO_URL=https://your-cloudpanel-domain.com

# -----------------------------------------------------------------------------
# Phase 2: SMTP Email (replaces Resend)
# -----------------------------------------------------------------------------
# SMTP_HOST=mail.your-domain.com
# SMTP_PORT=587
# SMTP_USER=noreply@your-domain.com
# SMTP_PASSWORD=your_smtp_password_here
# SMTP_FROM=VigilHealth <noreply@your-domain.com>

# -----------------------------------------------------------------------------
# Phase 2: Employee Data Encryption Key
# Used for pgcrypto column-level encryption of health data
# Generate with: openssl rand -base64 32
# -----------------------------------------------------------------------------
# EMPLOYEE_DATA_ENCRYPTION_KEY=your_encryption_key_here
